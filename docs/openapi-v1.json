{
  "openapi": "3.0.3",
  "info": {
    "title": "AgentHub Enterprise API Contract v1",
    "version": "1.0.0",
    "description": "Authoritative REST/SSE contract for AgentHub 8 production bounded contexts (identity, project, orchestration, execution, agent, audit, sandbox, ops). All timestamps use UTC ISO-8601. Supports X-API-Version: v1, X-Server-Timezone: UTC, ETag/If-None-Match (304 Not Modified), Idempotency-Key, and Last-Event-ID."
  },
  "servers": [
    {
      "url": "/",
      "description": "Default API Gateway"
    }
  ],
  "tags": [
    { "name": "identity", "description": "User authentication, JWT rotation, and single-use SSE stream tickets (1000-1999)" },
    { "name": "project", "description": "Managed projects and single-model /api/workspaces/{workspaceId} resources (2000-3009)" },
    { "name": "audit", "description": "Artifact review, JGit structured diff, and non-destructive revert (3010-3999)" },
    { "name": "agent", "description": "Agent definitions, LLM providers, routing policies, and token usage (5000-5999)" },
    { "name": "orchestration", "description": "Versioned workflow templates, DAG topology validation, and approvals (6000-6019)" },
    { "name": "execution", "description": "WorkflowRun, StepRun, RunEvent SSE stream, and Run Evidence Bundle (6020-6999)" },
    { "name": "sandbox", "description": "Controlled sandbox preview deployments and lifecycle management (7000-7999)" },
    { "name": "ops", "description": "System health, API v1 contract metadata, OpenAPI spec, and legacy endpoint telemetry (8000-8999)" }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": ["identity"],
        "summary": "Authenticate user credentials and issue JWT",
        "responses": { "200": { "description": "Result<AuthTokenView> in UTC" } }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["identity"],
        "summary": "Register user account",
        "responses": { "200": { "description": "Result<AuthTokenView> in UTC" } }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["identity"],
        "summary": "Rotate JWT token and invalidate prior JTI",
        "responses": { "200": { "description": "Result<AuthTokenView> in UTC" } }
      }
    },
    "/api/auth/stream-ticket": {
      "post": {
        "tags": ["identity"],
        "summary": "Issue 60s single-use SSE stream ticket",
        "responses": { "200": { "description": "Result<Map<String, String>>" } }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["identity"],
        "summary": "Get current authenticated principal",
        "responses": { "200": { "description": "Result<UserView>" } }
      }
    },
    "/api/projects": {
      "get": {
        "tags": ["project"],
        "summary": "List projects owned by current user",
        "responses": { "200": { "description": "Result<List<ProjectView>>" } }
      },
      "post": {
        "tags": ["project"],
        "summary": "Create project and provision managed JGit workspace",
        "responses": { "200": { "description": "Result<ProjectView> with ETag header" } }
      }
    },
    "/api/projects/page": {
      "get": {
        "tags": ["project"],
        "summary": "List projects with standardized v1 pagination and sorting",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } },
          { "name": "sortBy", "in": "query", "schema": { "type": "string", "default": "createdAt" } },
          { "name": "sortDir", "in": "query", "schema": { "type": "string", "enum": ["ASC", "DESC"], "default": "DESC" } }
        ],
        "responses": { "200": { "description": "Result<PageResultView<ProjectView>>" } }
      }
    },
    "/api/projects/{id}": {
      "get": {
        "tags": ["project"],
        "summary": "Get project details with weak ETag and If-None-Match (304 Not Modified) support",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "If-None-Match", "in": "header", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Result<ProjectView> with ETag header" },
          "304": { "description": "Not Modified (ETag matched)" }
        }
      }
    },
    "/api/workspaces/{workspaceId}/tree": {
      "get": {
        "tags": ["project"],
        "summary": "List workspace file tree via WorkspaceApplication (zero host path leakage)",
        "responses": { "200": { "description": "Result<List<WorkspaceFileNode>>" } }
      }
    },
    "/api/workspaces/{workspaceId}/file": {
      "get": {
        "tags": ["project"],
        "summary": "Read workspace file detail",
        "responses": { "200": { "description": "Result<WorkspaceFileDetailView>" } }
      },
      "post": {
        "tags": ["project"],
        "summary": "Write workspace file",
        "responses": { "200": { "description": "Result<Void>" } }
      },
      "delete": {
        "tags": ["project"],
        "summary": "Delete workspace file",
        "responses": { "200": { "description": "Result<Void>" } }
      }
    },
    "/api/workspaces/{workspaceId}/diff": {
      "get": {
        "tags": ["project"],
        "summary": "Compute structured JGit diff against workspace baseline",
        "responses": { "200": { "description": "Result<StructuredDiff>" } }
      }
    },
    "/api/workspaces/{workspaceId}/git/snapshot": {
      "post": {
        "tags": ["project"],
        "summary": "Create JGit commit snapshot and audit artifact",
        "responses": { "200": { "description": "Result<Map<String, Object>>" } }
      }
    },
    "/api/workspaces/{workspaceId}/lock/status": {
      "get": {
        "tags": ["project"],
        "summary": "Get workspace lock lease status via WorkspaceLockStatusView DTO",
        "responses": { "200": { "description": "Result<WorkspaceLockStatusView>" } }
      }
    },
    "/api/projects/onboarding/start": {
      "post": {
        "tags": ["project"],
        "summary": "Start 7-step project onboarding wizard and verify source",
        "responses": { "200": { "description": "Result<OnboardingSessionView>" } }
      }
    },
    "/api/projects/onboarding/{sessionId}/step": {
      "post": {
        "tags": ["project"],
        "summary": "Execute onboarding wizard step",
        "responses": { "200": { "description": "Result<OnboardingSessionView>" } }
      }
    },
    "/api/projects/onboarding/{sessionId}/retry": {
      "post": {
        "tags": ["project"],
        "summary": "Retry failed onboarding wizard step",
        "responses": { "200": { "description": "Result<OnboardingSessionView>" } }
      }
    },
    "/api/projects/onboarding/{sessionId}": {
      "get": {
        "tags": ["project"],
        "summary": "Get onboarding wizard session details and audit steps",
        "responses": { "200": { "description": "Result<OnboardingSessionView>" } }
      }
    },
    "/api/projects/onboarding/{sessionId}/abort": {
      "post": {
        "tags": ["project"],
        "summary": "Abort onboarding and clean up temporary resources",
        "responses": { "200": { "description": "Result<OnboardingSessionView>" } }
      }
    },
    "/api/projects/onboarding/{sessionId}/complete": {
      "post": {
        "tags": ["project"],
        "summary": "Complete onboarding and finalize project baseline",
        "responses": { "200": { "description": "Result<ProjectView>" } }
      }
    },
    "/api/projects/{projectId}/context-sources": {
      "get": {
        "tags": ["project"],
        "summary": "List versioned context sources for project",
        "responses": { "200": { "description": "Result<List<ContextSourceView>>" } }
      },
      "post": {
        "tags": ["project"],
        "summary": "Register versioned context source with SHA-256 fingerprint",
        "responses": { "200": { "description": "Result<ContextSourceView>" } }
      }
    },
    "/api/projects/{projectId}/context-sources/{sourceId}": {
      "get": {
        "tags": ["project"],
        "summary": "Get versioned context source details and metadata by ID",
        "responses": { "200": { "description": "Result<ContextSourceView>" } }
      }
    },
    "/api/workspaces/{workspaceId}/resync": {
      "post": {
        "tags": ["project"],
        "summary": "Resync controlled workspace to baseline commit",
        "responses": { "200": { "description": "Result<WorkspaceView>" } }
      }
    },
    "/api/workspaces/{workspaceId}/change-baseline": {
      "post": {
        "tags": ["project"],
        "summary": "Change workspace git baseline with user confirmation",
        "responses": { "200": { "description": "Result<WorkspaceView>" } }
      }
    },
    "/api/workspaces/{workspaceId}/discard": {
      "post": {
        "tags": ["project"],
        "summary": "Discard uncommitted workspace changes with user confirmation",
        "responses": { "200": { "description": "Result<WorkspaceView>" } }
      }
    },
    "/api/workspaces/{workspaceId}/restore-snapshot": {
      "post": {
        "tags": ["project"],
        "summary": "Restore workspace to snapshot commit with user confirmation",
        "responses": { "200": { "description": "Result<WorkspaceView>" } }
      }
    },
    "/api/workspaces/{workspaceId}/quota": {
      "get": {
        "tags": ["project"],
        "summary": "Get workspace quota capacity, file count, and policy usage",
        "responses": { "200": { "description": "Result<WorkspaceQuotaUsage>" } }
      }
    },
    "/api/workflows/definitions": {
      "get": {
        "tags": ["orchestration"],
        "summary": "List versioned workflow templates",
        "responses": { "200": { "description": "Result<List<WorkflowDefinitionView>>" } }
      },
      "post": {
        "tags": ["orchestration"],
        "summary": "Create versioned workflow template",
        "responses": { "200": { "description": "Result<WorkflowDefinitionView>" } }
      }
    },
    "/api/workflows/templates": {
      "get": {
        "tags": ["orchestration"],
        "summary": "List canonical workflow templates (BUG_FIX_WITH_TESTS, NEW_FEATURE_ENDPOINT)",
        "responses": { "200": { "description": "Result<List<WorkflowTemplateView>>" } }
      }
    },
    "/api/workflows/orchestrator/plans": {
      "post": {
        "tags": ["orchestration"],
        "summary": "Generate structured Orchestrator plan with budget and quality gates",
        "responses": { "200": { "description": "Result<OrchestrationPlanView>" } }
      }
    },
    "/api/workflows/orchestrator/plans/{planId}/confirm": {
      "post": {
        "tags": ["orchestration"],
        "summary": "Confirm Orchestrator plan and authorize high-impact tools",
        "responses": { "200": { "description": "Result<OrchestrationPlanView>" } }
      }
    },
    "/api/executions/runs": {
      "post": {
        "tags": ["execution"],
        "summary": "Start workflow run with Idempotency-Key header deduplication",
        "parameters": [
          { "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Result<WorkflowRunView> with ETag header" } }
      }
    },
    "/api/executions/projects/{projectId}/runs/page": {
      "get": {
        "tags": ["execution"],
        "summary": "List workflow runs for project with v1 pagination, sorting, and status filter",
        "responses": { "200": { "description": "Result<PageResultView<WorkflowRunView>>" } }
      }
    },
    "/api/executions/runs/{runId}": {
      "get": {
        "tags": ["execution"],
        "summary": "Get workflow run with weak ETag and If-None-Match (304 Not Modified) support",
        "responses": {
          "200": { "description": "Result<WorkflowRunView> with ETag header" },
          "304": { "description": "Not Modified" }
        }
      }
    },
    "/api/executions/runs/{runId}/stream": {
      "get": {
        "tags": ["execution"],
        "summary": "Subscribe to authoritative Run SSE event stream with Last-Event-ID / afterSeq cursor",
        "responses": { "200": { "description": "text/event-stream" } }
      }
    },
    "/api/executions/runs/{runId}/evidence": {
      "get": {
        "tags": ["execution"],
        "summary": "Generate deterministic, secret-masked Run Evidence Bundle",
        "responses": { "200": { "description": "Result<RunEvidenceBundleView>" } }
      }
    },
    "/api/executions/runs/{runId}/operations": {
      "get": {
        "tags": ["execution"],
        "summary": "Get unified execution operations view, state machine decision, and memory summary",
        "responses": { "200": { "description": "Result<RunOperationsView>" } }
      }
    },
    "/api/executions/runs/{runId}/steps/{stepRunId}/rework": {
      "post": {
        "tags": ["execution"],
        "summary": "Request step rework with reviewer feedback and reset to PENDING",
        "responses": { "200": { "description": "Result<StepRunView>" } }
      }
    },
    "/api/executions/runs/{runId}/reject": {
      "post": {
        "tags": ["execution"],
        "summary": "Reject run, reset workspace changes to baseline, and mark status as REJECTED",
        "responses": { "200": { "description": "Result<WorkflowRunView>" } }
      }
    },
    "/api/executions/runs/{runId}/evidence/export": {
      "get": {
        "tags": ["execution"],
        "summary": "Export deterministic, secret-masked Run Evidence Package with SHA-256 checksum",
        "responses": { "200": { "description": "Result<RunEvidenceBundleView>" } }
      }
    },
    "/api/approvals/runs/{runId}": {
      "get": {
        "tags": ["orchestration"],
        "summary": "List human-in-the-loop approvals for run",
        "responses": { "200": { "description": "Result<List<ApprovalView>>" } }
      }
    },
    "/api/audit/artifacts/{artifactId}/revert": {
      "post": {
        "tags": ["audit"],
        "summary": "Non-destructively revert artifact change in JGit workspace",
        "responses": { "200": { "description": "Result<ArtifactView>" } }
      }
    },
    "/api/audit/artifacts/lineage/{runId}": {
      "get": {
        "tags": ["audit"],
        "summary": "Get full lifecycle artifact lineage view for run",
        "responses": { "200": { "description": "Result<ArtifactLineageView>" } }
      }
    },
    "/api/audit/artifacts/{artifactId}/diff": {
      "get": {
        "tags": ["audit"],
        "summary": "Get structured JGit diff review for artifact",
        "responses": { "200": { "description": "Result<StructuredDiff>" } }
      }
    },
    "/api/audit/artifacts/{artifactId}/quality-gate": {
      "get": {
        "tags": ["audit"],
        "summary": "Get quality gate evaluation report with SHA-256 fingerprint",
        "responses": { "200": { "description": "Result<QualityGateReport>" } }
      }
    },
    "/api/audit/artifacts/{artifactId}/quality-gate/evaluate": {
      "post": {
        "tags": ["audit"],
        "summary": "Evaluate quality gate rules across 5 dimensions",
        "responses": { "200": { "description": "Result<QualityGateReport>" } }
      }
    },
    "/api/audit/artifacts/{artifactId}/pr-draft": {
      "get": {
        "tags": ["audit"],
        "summary": "Generate structured Pull Request draft specification",
        "responses": { "200": { "description": "Result<PullRequestDraftView>" } }
      }
    },
    "/api/audit/artifacts/{artifactId}/revert-file": {
      "post": {
        "tags": ["audit"],
        "summary": "Revert a single modified file to git baseline commit",
        "responses": { "200": { "description": "Result<ArtifactView>" } }
      }
    },
    "/api/agents": {
      "get": {
        "tags": ["agent"],
        "summary": "List registered agent definitions",
        "responses": { "200": { "description": "Result<List<AgentDefinitionView>>" } }
      }
    },
    "/api/agents/tools": {
      "get": {
        "tags": ["agent"],
        "summary": "List registered agent tools with schemas and output limits",
        "responses": { "200": { "description": "Result<List<AgentToolDefinition>>" } }
      }
    },
    "/api/agents/context-assembly": {
      "post": {
        "tags": ["agent"],
        "summary": "Assemble layered context with per-layer token budgets and truncation",
        "responses": { "200": { "description": "Result<AssembledContext>" } }
      }
    },
    "/api/agents/evaluations/run": {
      "post": {
        "tags": ["agent"],
        "summary": "Execute offline evaluation benchmark suite across 5 core task categories",
        "responses": { "200": { "description": "Result<EvaluationReportView>" } }
      }
    },
    "/api/providers": {
      "get": {
        "tags": ["agent"],
        "summary": "List LLM providers",
        "responses": { "200": { "description": "Result<List<ProviderView>>" } }
      },
      "post": {
        "tags": ["agent"],
        "summary": "Register LLM provider",
        "responses": { "200": { "description": "Result<ProviderView>" } }
      }
    },
    "/api/providers/health": {
      "get": {
        "tags": ["agent"],
        "summary": "Get provider cluster health status and metrics",
        "responses": { "200": { "description": "Result<List<ProviderHealthView>>" } }
      }
    },
    "/api/providers/{id}/probe": {
      "post": {
        "tags": ["agent"],
        "summary": "Actively probe provider endpoint and measure latency",
        "responses": { "200": { "description": "Result<ProviderProbeResultView>" } }
      }
    },
    "/api/providers/{id}/circuit-breaker": {
      "get": {
        "tags": ["agent"],
        "summary": "Get provider circuit breaker status and metrics",
        "responses": { "200": { "description": "Result<CircuitBreakerView>" } }
      }
    },
    "/api/providers/{id}/circuit-breaker/reset": {
      "post": {
        "tags": ["agent"],
        "summary": "Reset provider circuit breaker state to CLOSED",
        "responses": { "200": { "description": "Result<CircuitBreakerView>" } }
      }
    },
    "/api/token-usages/governance": {
      "get": {
        "tags": ["agent"],
        "summary": "Get token usage and cost budget governance overview",
        "responses": { "200": { "description": "Result<TokenGovernanceView>" } }
      }
    },
    "/api/token-usages/budget/check": {
      "post": {
        "tags": ["agent"],
        "summary": "Pre-check cost and token budget before execution",
        "responses": { "200": { "description": "Result<BudgetCheckResultView>" } }
      }
    },
    "/api/deployments": {
      "get": {
        "tags": ["sandbox"],
        "summary": "List sandbox deployments for project",
        "responses": { "200": { "description": "Result<List<DeploymentResponse>>" } }
      },
      "post": {
        "tags": ["sandbox"],
        "summary": "Create controlled sandbox preview deployment",
        "responses": { "200": { "description": "Result<DeploymentResponse>" } }
      }
    },
    "/api/deployments/{id}/probe": {
      "post": {
        "tags": ["sandbox"],
        "summary": "Execute active HTTP health check probe for sandbox deployment",
        "responses": { "200": { "description": "Result<DeploymentResponse>" } }
      }
    },
    "/api/teams/projects/{projectId}/roles/me": {
      "get": {
        "tags": ["project"],
        "summary": "Get current user role and permissions on project",
        "responses": { "200": { "description": "Result<ProjectUserRoleView>" } }
      }
    },
    "/api/teams/projects/{projectId}/members": {
      "get": {
        "tags": ["project"],
        "summary": "List project team members",
        "responses": { "200": { "description": "Result<List<ProjectMemberView>>" } }
      },
      "post": {
        "tags": ["project"],
        "summary": "Add team member to project with RBAC role",
        "responses": { "200": { "description": "Result<ProjectMemberView>" } }
      }
    },
    "/api/teams/projects/{projectId}/members/{memberId}/role": {
      "put": {
        "tags": ["project"],
        "summary": "Update project team member RBAC role",
        "responses": { "200": { "description": "Result<ProjectMemberView>" } }
      }
    },
    "/api/system/audit-logs": {
      "get": {
        "tags": ["ops"],
        "summary": "Query immutable audit logs and security trace history",
        "responses": { "200": { "description": "Result<PageResultView<AuthAuditLogView>>" } }
      }
    },
    "/api/system/metrics/summary": {
      "get": {
        "tags": ["ops"],
        "summary": "Get aggregated Prometheus/Micrometer metrics and SLO indicators",
        "responses": { "200": { "description": "Result<OpsMetricsSummaryView>" } }
      }
    },
    "/api/system/backup": {
      "post": {
        "tags": ["ops"],
        "summary": "Trigger point-in-time consistent disaster recovery backup snapshot",
        "responses": { "200": { "description": "Result<BackupManifest>" } }
      }
    },
    "/api/system/backup/verify": {
      "post": {
        "tags": ["ops"],
        "summary": "Verify cryptographic and structural integrity of backup archive",
        "responses": { "200": { "description": "Result<BackupManifest>" } }
      }
    },
    "/api/system/backup/restore": {
      "post": {
        "tags": ["ops"],
        "summary": "Restore backup snapshot to target workspace and live database",
        "responses": { "200": { "description": "Result<RestoreVerificationReport>" } }
      }
    },
    "/api/system/health": {
      "get": {
        "tags": ["ops"],
        "summary": "Get system health status in UTC",
        "responses": { "200": { "description": "Result<Map<String, Object>>" } }
      }
    },
    "/api/system/contracts/v1": {
      "get": {
        "tags": ["ops"],
        "summary": "Get API v1 contract metadata, bounded context registry, and legacy route telemetry",
        "responses": { "200": { "description": "Result<Map<String, Object>>" } }
      }
    },
    "/api/system/legacy-endpoints": {
      "get": {
        "tags": ["ops"],
        "summary": "Get deprecated legacy endpoint invocation counts",
        "responses": { "200": { "description": "Result<Map<String, Long>>" } }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "tags": ["ops"],
        "summary": "Get OpenAPI 3.0.3 contract specification",
        "responses": { "200": { "description": "OpenAPI 3.0.3 JSON document" } }
      }
    }
  }
}
