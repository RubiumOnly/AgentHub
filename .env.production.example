# ==============================================================================
# AgentHub Production Environment Variables Template
# Copy this file to .env.production and replace ALL ChangeMe / placeholder values
# with strong random secrets before running scripts/deploy-prod.sh (.ps1).
# DO NOT COMMIT .env.production WITH REAL SECRETS TO GIT!
# ==============================================================================

# Container Image Commit SHA Tag (set automatically by deploy-prod script or CI)
IMAGE_TAG=1.0.0

# Database Credentials (Required: minimum 12 chars, must replace ChangeMe placeholder)
MYSQL_ROOT_PASSWORD=ChangeMe_ReplaceWithStrongRootPassword
MYSQL_DATABASE=agenthub
MYSQL_USER=agenthub_app
MYSQL_PASSWORD=ChangeMe_ReplaceWithStrongAppPassword

# Optional Redis Cache & Locking (Leave empty if unused, or provide >=12 char password)
REDIS_PASSWORD=ChangeMe_ReplaceWithStrongRedisPassword

# Authentication & JWT Hardened Secret (Required in production, minimum 32 chars, no placeholders)
AGENTHUB_AUTH_SECRET=ChangeMe_Placeholder_ReplaceWith64CharRandomProductionJwtSecretKey

# Observability / Prometheus Scrape Token (Required for external /actuator/prometheus access in prod)
ACTUATOR_PROMETHEUS_TOKEN=ChangeMe_Placeholder_ReplaceWithObservabilityScrapeToken

# Gateway Ports (Local staging/demo uses HTTP_PORT; production TLS uses HTTPS_PORT with docker/nginx/agenthub-tls.conf)
HTTP_PORT=80
HTTPS_PORT=443

# Model Provider API Keys (Leave empty if unused, or replace with real provider keys)
DEEPSEEK_API_KEY=your-deepseek-api-key-placeholder
ANTHROPIC_API_KEY=your-anthropic-api-key-placeholder
OPENAI_API_KEY=your-openai-api-key-placeholder
GEMINI_API_KEY=your-gemini-api-key-placeholder

# Provider Execution Mode: LIVE_SELF_HOSTED (default), DEMO_SIMULATED, or LIVE_TEAM
AGENTHUB_PROVIDER_MODE=LIVE_SELF_HOSTED

# Token & Hard Budget Governance (USD)
AGENTHUB_BUDGET_HARD_LIMIT_USD=50.00
AGENTHUB_BUDGET_WARNING_RATIO=0.80
